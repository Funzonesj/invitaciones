{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "controlhorario.funzonepro.com" }],
      "destination": "/fichaje.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "funzonepro.com" }],
      "missing": [
        { "type": "query", "key": "inv" },
        { "type": "query", "key": "rec" },
        { "type": "query", "key": "papa" }
      ],
      "destination": "/shell.html"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.funzonepro.com" }],
      "missing": [
        { "type": "query", "key": "inv" },
        { "type": "query", "key": "rec" },
        { "type": "query", "key": "papa" }
      ],
      "destination": "/shell.html"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }]
    },
    {
      "source": "/(.*).html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }]
    }
  ]
}
